#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>
#include <signal.h>

#define MAX_LINES 100000

static int g_fd = -1;
static int g_nlines = 0;
static off_t g_offsets[MAX_LINES];
static size_t g_lengths[MAX_LINES];

static void print_all(void) {
    int i;
    char *line;
    for (i = 0; i < g_nlines; ++i) {
        if (lseek(g_fd, g_offsets[i], SEEK_SET) == (off_t)-1) continue;
        line = malloc(g_lengths[i] + 1);
        if (!line) return;
        ssize_t got = read(g_fd, line, g_lengths[i]);
        if (got > 0) {
            line[got] = '\0';
            printf("%s", line);
            if (line[got - 1] != '\n') printf("\n");
        }
        free(line);
    }
}

static void on_alarm(int sig) {
    (void)sig;
    const char *msg = "\nTime is up! Printing whole file:\n";
    write(1, msg, strlen(msg));
    print_all();
    if (g_fd >= 0) close(g_fd);
    _exit(0);
}

int main(int argc, char *argv[]) {
    if (argc < 2) { fprintf(stderr, "Usage: %s file\n", argv[0]); return 1; }

    g_fd = open(argv[1], O_RDONLY);
    if (g_fd < 0) { perror("open"); return 1; }

    g_offsets[0] = 0;
    off_t pos = 0;
    char c;
    size_t cur_len = 0;

    while (read(g_fd, &c, 1) == 1) {
        pos++;
        cur_len++;
        if (c == '\n') {
            g_lengths[g_nlines] = cur_len;
            g_nlines++;
            if (g_nlines >= MAX_LINES) break;
            g_offsets[g_nlines] = pos;
            cur_len = 0;
        }
    }
    if (cur_len > 0 && g_nlines < MAX_LINES) {
        g_lengths[g_nlines] = cur_len;
        g_nlines++;
    }

    signal(SIGALRM, on_alarm);
    alarm(5);

    int num;
    printf("Enter line number (0 to quit), 5 sec timeout: ");
    fflush(stdout);
    if (scanf("%d", &num) != 1) {
        if (g_fd >= 0) close(g_fd);
        return 0;
    }
    alarm(0);

    if (num == 0) { close(g_fd); return 0; }
    if (num < 1 || num > g_nlines) {
        printf("No such line (file has %d lines)\n", g_nlines);
        close(g_fd);
        return 0;
    }

    int idx = num - 1;
    lseek(g_fd, g_offsets[idx], SEEK_SET);
    char *line = malloc(g_lengths[idx] + 1);
    if (!line) { perror("malloc"); close(g_fd); return 1; }
    ssize_t got = read(g_fd, line, g_lengths[idx]);
    if (got > 0) {
        line[got] = '\0';
        printf("%s", line);
        if (line[got - 1] != '\n') printf("\n");
    }
    free(line);
    close(g_fd);
    return 0;
}
